# =============================================
# Multi-Tenant SaaS — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# =============================================

# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multitenant_saas?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Application
APP_PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Email (SMTP) — Gunakan Resend, Brevo, atau Gmail
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@saas-platform.com"

# Midtrans Payment Gateway
# Dapatkan keys di: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"
