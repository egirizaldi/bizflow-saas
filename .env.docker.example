# ========================================================
# BIZFLOW SAAS — DOCKER PRODUCTION ENVIRONMENT TEMPLATE
# ========================================================

# -----------------
# 1. DATABASE (POSTGRESQL)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password_change_me
POSTGRES_DB=multitenant_saas
POSTGRES_PORT=5432

# -----------------
# 2. REDIS
# -----------------
REDIS_PORT=6379

# -----------------
# 3. AUTH & JWT
# -----------------
JWT_SECRET=generate-a-strong-random-jwt-secret-string-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-a-strong-random-refresh-secret-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# -----------------
# 4. FRONTEND DOMAIN
# -----------------
FRONTEND_URL=http://localhost

# -----------------
# 5. MIDTRANS PAYMENT GATEWAY
# -----------------
MIDTRANS_SERVER_KEY=SB-Mid-server-your-sandbox-or-prod-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-sandbox-or-prod-key
MIDTRANS_IS_PRODUCTION=false

# -----------------
# 6. TRANSACTIONAL EMAIL (SMTP)
# -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="BizFlow SaaS <no-reply@bizflow.com>"
